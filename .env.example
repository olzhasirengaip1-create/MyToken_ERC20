# Скопируйте этот файл в .env и заполните значения.
# Sepolia RPC URL получите у провайдера RPC.
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# Приватный ключ ТОЛЬКО отдельного тестового кошелька. Никогда не публикуйте его.
PRIVATE_KEY=
# Адрес развёрнутого контракта из Remix.
CONTRACT_ADDRESS=
ABI_PATH=contract_abi.json
S